# Copia este archivo a .env (raíz) y apps/web/.env.local, y completa los valores.

# Postgres de Supabase (Project Settings > Database > Connection string).
# Local y migraciones: modo "Session", puerto 5432. En Vercel (serverless): modo "Transaction", puerto 6543.
DATABASE_URL=postgresql://postgres.<id-proyecto>:<clave-codificada>@aws-X-<region>.pooler.supabase.com:5432/postgres

# Better Auth: genera con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage (buckets: "publico" y "privado")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de datos privados (documento del proveedor). AES-256-GCM + huella HMAC.
# Genera con `openssl rand -base64 32`. Si se pierde, los documentos cifrados no se recuperan: guárdala en un gestor de claves.
DOCUMENTOS_CLAVE=

# Correo saliente (Resend, resend.com). Sin ella los correos salen en la consola de `pnpm dev`.
# Remitente: noreply@lastresb.com.co (el dominio debe estar verificado en Resend).
RESEND_API_KEY=

# Direcciones → coordenadas (Google Geocoding API). Sin ella, «¿Qué estás buscando?» solo ordena por cercanía
# con la ubicación del navegador; la dirección escrita se guarda pero no se mide.
GOOGLE_MAPS_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO y analítica. Solo se indexa y se mide cuando VERCEL_ENV=production (Vercel lo pone solo).
# En producción NEXT_PUBLIC_SITE_URL debe ser https://lastresb.com.co (URL canónica).
GOOGLE_SITE_VERIFICATION=PV2Tc0MI8AE_GoDiaFVqWuM09AtV7Ie2ANLyKtOexRU
NEXT_PUBLIC_GA_ID=G-LJPS2R11K6

# VPS: "true" solo en producción (fuera de Vercel) para permitir indexación
SITIO_INDEXABLE=

# WhatsApp del equipo para el botón «Necesito que un asesor me ayude» en el ingreso (10 dígitos o con 57). Sin él, el botón no aparece.
NEXT_PUBLIC_WHATSAPP_AYUDA=

# --- Avisos de actividad de proveedores (B1) ---
# Correo del fundador que recibe cada movimiento de un proveedor (no se escribe en el código).
ADMIN_NOTIFY_EMAIL=admin@ejemplo.com
# false apaga todo (la vista «Actividad reciente» sigue registrando, pero no se envían correos).
NOTIFY_PROVIDER_EVENTS=true
# Los cambios de un mismo proveedor se agrupan en un solo correo dentro de esta ventana.
NOTIFY_WINDOW_MINUTES=5
NOTIFY_FROM="LasTresB <notificaciones@lastresb.com.co>"
# true: muestra el correo en consola y no envía nada.
NOTIFY_DRY_RUN=false
# Secreto del proceso programado (llama a /api/cron/avisos cada minuto con «Authorization: Bearer <secreto>»).
CRON_SECRET=cambia-este-secreto

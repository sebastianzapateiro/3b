# Copia este archivo a .env (raíz) y apps/web/.env.local, y completa los valores.

# Postgres de Supabase (Project Settings > Database > Connection string).
# Local y migraciones: modo "Session", puerto 5432. En Vercel (serverless): modo "Transaction", puerto 6543.
DATABASE_URL=postgresql://postgres.sgxvwwzotfiglqbmizvi:FAJ2aFp67c0YHjkC@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Better Auth: genera con `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage (buckets: "publico" y "privado")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO y analítica. Solo se indexa y se mide cuando VERCEL_ENV=production (Vercel lo pone solo).
# En producción NEXT_PUBLIC_SITE_URL debe ser https://lastresb.com.co (URL canónica).

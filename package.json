{
  "name": "las3b",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @las3b/web test",
    "db:generate": "pnpm --filter @las3b/db db:generate",
    "db:migrate": "pnpm --filter @las3b/db db:migrate",
    "db:seed": "pnpm --filter @las3b/db db:seed",
    "admin:crear": "pnpm --filter @las3b/db admin:crear",
    "db:cifrar-documentos": "pnpm --filter @las3b/db db:cifrar-documentos",
    "usuarios": "pnpm --filter @las3b/db usuarios",
    "db:studio": "pnpm --filter @las3b/db db:studio",
    "docs:diagramas": "node scripts/diagramas.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
